# Copy this file to .env and fill in your values
# NEVER commit the actual .env file

# --- DATABASE ---
DATABASE_URL=postgresql://admin:changeme@localhost:5432/discount_db

# --- AI ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- FIREBASE ---
# Paste the full JSON content of your Firebase service account key (single line)
FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# --- GOOGLE MAPS ---
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# --- CRON ---
CRON_SECRET=your-random-secret-for-cron-endpoint

# --- LOCAL DOCKER (override docker-compose defaults) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme_local
POSTGRES_DB=discount_db
